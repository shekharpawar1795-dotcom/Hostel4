<%- include('partials/header', { title: 'Change password' }) %>
<div class="page-header">
  <div>
    <div class="eyebrow">ACCOUNT SECURITY</div>
    <h1>Change your password</h1>
    <p>Choose a unique password you do not use on another website.</p>
  </div>
</div>

<div class="card form-card">
  <% if (user.force_password_change) { %>
  <div class="alert alert-warning">Your account uses a temporary password. Please change it to continue.</div>
  <% } %>
  <form method="post" action="/profile/password">
    <input type="hidden" name="csrf_token" value="<%= locals.csrf || '' %>">
    <label for="old">Current password</label>
    <input id="old" type="password" name="old_password" autocomplete="current-password" required>
    
    <label for="new">New password</label>
    <input id="new" name="new_password" type="password" minlength="8" maxlength="128" autocomplete="new-password" required>
    <p class="field-help">At least 8 characters, including letters and digits.</p>
    
    <label for="confirm">Confirm new password</label>
    <input id="confirm" name="confirm_password" type="password" minlength="8" autocomplete="new-password" required>
    
    <button class="btn btn-primary" type="submit">Update password</button>
  </form>
</div>
<%- include('partials/footer') %>
