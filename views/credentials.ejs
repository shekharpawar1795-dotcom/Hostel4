<%- include('partials/header', { title: 'Temporary credentials' }) %>
<div class="page-header">
  <div>
    <div class="eyebrow">ONE-TIME CREDENTIAL HANDOFF</div>
    <h1>New account credentials</h1>
    <p>Copy these passwords now. They are not stored in readable form and will not be shown again.</p>
  </div>
  <a class="btn btn-outline" href="/dashboard">Back to admin</a>
</div>

<div class="alert alert-warning">
  <strong>Security:</strong> Issue credentials individually through an approved private channel. Do not send the full list to students or share a common default password. Students must set their own password at first login.
</div>

<% if (locals.duplicates && duplicates.length > 0) { %>
<div class="alert alert-warning">Skipped existing URNs: <%= duplicates.join(', ') %></div>
<% } %>

<div class="card">
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>URN / Login ID</th>
          <th>Name</th>
          <th>Temporary password</th>
        </tr>
      </thead>
      <tbody>
        <% if (new_credentials && new_credentials.length > 0) { %>
          <% new_credentials.forEach(([login, name, password]) => { %>
          <tr>
            <td><strong><%= login %></strong></td>
            <td><%= name %></td>
            <td><code><%= password %></code></td>
          </tr>
          <% }) %>
        <% } else { %>
          <tr><td colspan="3">No new accounts created.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
<p class="muted">Temporary passwords cannot be retrieved later. Use an administrator password reset if one is lost.</p>
<%- include('partials/footer') %>
